---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import PostList from "@components/PostList.astro";
import PostRow from "@components/PostRow.astro";
import { BLOG } from "@consts";
import { getPosts, type Post } from "@lib/content";

const posts = await getPosts();

const byYear = posts.reduce<Record<string, Post[]>>((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  (acc[year] ??= []).push(post);
  return acc;
}, {});

const years = Object.keys(byYear).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <p class="eyebrow" data-intro="fade" data-intro-at="0">Archive</p>
    <h1 class="page-title mt-4" data-intro="lines" data-intro-at="0.1">Posts</h1>
    <p class="mt-3 text-[15px]" data-intro="fade" data-intro-at="0.35">
      {BLOG.DESCRIPTION} {posts.length} posts so far.
    </p>

    <div class="mt-14 space-y-12">
      {years.map((year) => (
        <section class="year-grid">
          <h2 class="year" data-intro="fade" data-intro-at="0.5">{year}</h2>
          <PostList data-intro="rows" data-intro-at="0.55">
            {byYear[year].map((post) => <PostRow post={post} />)}
          </PostList>
        </section>
      ))}
    </div>
  </Container>
</PageLayout>
