---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import SeriesCard from "@components/SeriesCard.astro";
import { SERIES } from "@consts";
import { getSeries } from "@lib/content";

const series = await getSeries();
---

<PageLayout title={SERIES.TITLE} description={SERIES.DESCRIPTION}>
  <Container>
    <p class="eyebrow" data-intro="fade" data-intro-at="0">Series</p>
    <h1 class="page-title mt-4" data-intro="lines" data-intro-at="0.1">Series</h1>
    <p class="mt-3 text-[15px]" data-intro="fade" data-intro-at="0.35">{SERIES.DESCRIPTION}</p>

    <div class="mt-14 flex flex-col gap-4" data-intro="fade" data-intro-at="0.5">
      {series.map((s) => <SeriesCard series={s} />)}
    </div>
  </Container>
</PageLayout>
