---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import PostList from "@components/PostList.astro";
import PostRow from "@components/PostRow.astro";
import SeriesCard from "@components/SeriesCard.astro";
import TechStack from "@components/TechStack.astro";
import Socials from "@components/Socials.astro";
import { SITE, HOME } from "@consts";
import { getPosts, getSeries } from "@lib/content";

const posts = await getPosts();
const series = await getSeries(posts);
const latest = posts.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section>
      <p class="eyebrow mb-5" data-intro="fade" data-intro-at="0.1">Notes on building things</p>
      <p class="intro" data-intro="lines" data-intro-at="0.2">
        I write these mostly so future me can look them up.
        <em>If they help you too, even better.</em>
      </p>
      <TechStack data-intro="pop" data-intro-at="0.7" />
    </section>

    {series.length > 0 && (
      <section class="section" data-intro="fade" data-intro-at="0.95">
        <div class="section-head">
          <h2>Series</h2>
          <a href="/series" class="link-u">All series</a>
        </div>
        <div class="flex flex-col gap-4">
          {series.map((s) => <SeriesCard series={s} />)}
        </div>
      </section>
    )}

    <section class="section">
      <div class="section-head" data-intro="fade" data-intro-at="1.05">
        <h2>Latest</h2>
        <a href="/blog" class="link-u">See all posts</a>
      </div>
      <PostList data-intro="rows" data-intro-at="1.15">
        {latest.map((post) => <PostRow post={post} />)}
      </PostList>
    </section>

    <section id="connect" class="section">
      <div class="section-head" data-intro="fade" data-intro-at="1.45"><h2>Say hi</h2></div>
      <Socials data-intro="pop" data-intro-at="1.5" />
    </section>
  </Container>
</PageLayout>
